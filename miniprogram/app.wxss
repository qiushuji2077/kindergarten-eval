page{background:#F7F7F2;color:#273D33;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:32rpx;line-height:1.7}
view,text,button,input,textarea{box-sizing:border-box}button{margin:0;border:0;border-radius:14rpx;font-size:32rpx;font-weight:500;line-height:1.4;min-height:96rpx;padding:24rpx 28rpx;color:#244D3F;background:#E9EEE7}button::after{border:0}button[disabled]{color:#7B827A;background:#E5E8E1;opacity:1}
input,textarea{width:100%;font-family:inherit;font-size:32rpx;line-height:1.7;color:#273D33;background:transparent}input{min-height:88rpx}textarea{padding:18rpx 0;min-height:210rpx}checkbox{transform:scale(.82);transform-origin:left center}switch{transform:scale(.85);transform-origin:right center}
.page{padding:40rpx 40rpx calc(56rpx + env(safe-area-inset-bottom))}.compose-page{padding-bottom:280rpx}.eyebrow{font-size:24rpx;font-weight:600;letter-spacing:3rpx;color:#627165}.title{font-size:52rpx;font-weight:600;letter-spacing:-1rpx;line-height:1.35;margin-top:8rpx}.subtitle{color:#617166;font-size:30rpx;line-height:1.7;margin-top:14rpx}.small{font-size:26rpx;color:#69776C;line-height:1.65}.muted{color:#69776C}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.stack{display:flex;flex-direction:column;gap:20rpx}.flex{flex:1;min-width:0}.primary{background:#244D3F;color:#fff}.secondary{border:1rpx solid #D1DBD0;background:#FCFCF8}.quiet{padding:16rpx 0;background:transparent;min-height:72rpx;font-size:28rpx;text-align:left;color:#476650}.danger{color:#974A39;background:#F8ECE5}.link{color:#365E49;text-decoration:underline;font-size:26rpx}.space{margin-top:32rpx}.rule{height:1rpx;background:#DDE3D8;margin:32rpx 0}.section-title{font-size:32rpx;line-height:1.5;font-weight:600;margin:0 0 22rpx}.section-label{font-size:23rpx;letter-spacing:3rpx;color:#69776C;margin-bottom:18rpx}.label{display:block;font-size:26rpx;font-weight:500;color:#526659;margin:22rpx 0 10rpx}.error{padding:22rpx 24rpx;background:#F7E8DF;border-left:4rpx solid #AB644A;color:#803F2E;font-size:28rpx;line-height:1.6;margin:24rpx 0;word-break:break-word}.notice{padding:18rpx 22rpx;background:#EAF0E7;color:#4F6757;font-size:26rpx;line-height:1.65;border-radius:8rpx}.demo-notice{background:#F3ECDA;color:#7A6139}.field{border-bottom:1rpx solid #CFD8CA;padding:6rpx 0}.pill{display:inline-block;padding:7rpx 16rpx;border-radius:8rpx;color:#526A58;background:#E8EEE4;font-size:24rpx;line-height:1.5}.pill.pending{color:#7A5D31;background:#F5EDDA}.empty{padding:52rpx 12rpx;color:#647367;text-align:center;font-size:28rpx;line-height:1.75}.empty-title{font-size:34rpx;color:#3C5747;margin-bottom:14rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chip{padding:16rpx 22rpx;min-height:80rpx;background:#FDFDF9;border:1rpx solid #D3DDCF;border-radius:10rpx;font-size:28rpx}.chip.on{background:#E3ECDF;border-color:#44694D;color:#244D3F;font-weight:600}.sheet{background:#FEFEFA;padding:28rpx;border:1rpx solid #E1E6DC;border-radius:14rpx}.preview-mask{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(23,40,29,.42);z-index:100;display:flex;align-items:flex-end}.preview-sheet{width:100%;max-height:88vh;overflow:auto;border-radius:28rpx 28rpx 0 0;background:#FDFDF8;padding:40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom))}.preview-sheet textarea{height:280rpx;margin:24rpx 0;background:#F1F4ED;padding:22rpx;border-radius:12rpx}.privacy-buttons{display:flex;gap:16rpx}.privacy-buttons button{flex:1}.footer-note{margin-top:48rpx;font-size:26rpx;line-height:1.75;color:#71806F}.version{font-size:24rpx;color:#7B8976;margin-top:18rpx}.code{font-family:monospace;font-size:22rpx;word-break:break-all;padding:18rpx;background:#EEF2E8;user-select:text}

.row>.quiet{flex:0 0 auto;width:auto}
