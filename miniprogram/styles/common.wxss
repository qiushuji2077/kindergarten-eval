.page { min-height: 100vh; padding-bottom: 24rpx; }
.title { font-size: 68rpx; font-weight: 700; padding: 24rpx 32rpx 8rpx; }
.lead { color: #8e8e93; font-size: 28rpx; padding: 0 32rpx 24rpx; }
.section { color: #8e8e93; font-size: 26rpx; padding: 36rpx 32rpx 12rpx; }
.group { background: #fff; }
.cell { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx; border-top: 1rpx solid rgba(60,60,67,0.12); }
.cell:first-child { border-top: none; }
.name { font-size: 34rpx; }
.sub { font-size: 26rpx; color: #8e8e93; margin-top: 6rpx; }
.mark { color: #007aff; font-size: 28rpx; }
.btn { margin: 32rpx; height: 96rpx; line-height: 96rpx; text-align: center; background: #007aff; color: #fff; border-radius: 24rpx; font-size: 34rpx; font-weight: 600; }
.btn[disabled] { opacity: 0.4; }
.search { margin: 16rpx 32rpx 8rpx; background: rgba(118,118,128,0.12); border-radius: 20rpx; height: 72rpx; padding: 0 24rpx; font-size: 32rpx; }
.row { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 32rpx; background: #fff; border-top: 1rpx solid rgba(60,60,67,0.12); }
.row-body { flex: 1; min-width: 0; }
.row-title { font-size: 34rpx; font-weight: 600; }
.row-excerpt { font-size: 28rpx; color: #3c3c43; opacity: 0.7; margin-top: 6rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.row-meta { font-size: 24rpx; color: #8e8e93; margin-top: 6rpx; }
.thumb { width: 112rpx; height: 112rpx; border-radius: 16rpx; background: #e5e5ea; flex-shrink: 0; }
.empty { text-align: center; color: #8e8e93; padding: 120rpx 40rpx; }
.plus { color: #007aff; font-size: 56rpx; padding: 0 32rpx; }
.title-row { display: flex; align-items: flex-end; justify-content: space-between; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 32rpx 16rpx; }
.chip { padding: 10rpx 24rpx; border-radius: 32rpx; background: #fff; font-size: 28rpx; }
.chip.on { background: #007aff; color: #fff; }
.area { width: 100%; min-height: 220rpx; padding: 16rpx 32rpx; font-size: 34rpx; box-sizing: border-box; }
.tools { display: flex; gap: 16rpx; padding: 0 32rpx 16rpx; }
.tool { flex: 1; text-align: center; background: #fff; color: #007aff; height: 72rpx; line-height: 72rpx; border-radius: 16rpx; font-size: 28rpx; }
.hit { padding: 20rpx 32rpx; background: #fff; border-top: 1rpx solid rgba(60,60,67,0.12); }
.hit-title { font-size: 30rpx; }
.hit-sub { font-size: 24rpx; color: #8e8e93; margin-top: 6rpx; }
.error { color: #ff3b30; padding: 16rpx 32rpx; font-size: 26rpx; }
.preview { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 32rpx 16rpx; }
.preview image, .preview video { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
