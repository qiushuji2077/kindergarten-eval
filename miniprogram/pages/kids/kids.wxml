<view class="page">
  <view class="title">幼儿</view>
  <view class="lead">演示班名单可改。正式带班请改成自己班的名字。</view>
  <view class="section">{{className}} · {{list.length}}人</view>
  <view class="group">
    <view class="cell" wx:for="{{list}}" wx:key="id">
      <view>
        <view class="name">{{item.name}}</view>
        <view class="sub">{{item.gender}} {{item.birthday}}</view>
      </view>
    </view>
  </view>
  <view class="section">添加幼儿</view>
  <view class="group">
    <view class="cell">
      <text class="name">姓名</text>
      <input placeholder="小麦" value="{{name}}" bindinput="onName" style="text-align:right" />
    </view>
  </view>
  <view class="btn" bindtap="add">添加到本班</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
