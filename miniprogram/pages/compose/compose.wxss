.notebook{background:#FDFDF9;border:1rpx solid #DDE5D6;border-radius:12rpx;padding:24rpx 28rpx}.notebook textarea{min-height:240rpx;line-height:1.9;font-size:32rpx}.count{text-align:right}.time-row{border-top:1rpx solid #DDE3D8;padding-top:22rpx;margin-top:24rpx;gap:12rpx}.time-row picker{padding:12rpx;min-height:72rpx}.clue{border-left:4rpx solid #BB9B68;background:#F2F2E9;padding:24rpx 26rpx;margin-top:22rpx;overflow-wrap:anywhere}.clue-title{font-size:32rpx;font-weight:600}.evidence{font-size:30rpx;color:#294C38;margin:18rpx 0;line-height:1.8}.clue-copy{font-size:28rpx;color:#53644E;line-height:1.8}.clue-next{font-size:26rpx;border-top:1rpx solid #D8DFCD;padding-top:16rpx;margin-top:18rpx;color:#67724F}.teacher-note{border:1rpx solid #D8E1D1;border-radius:10rpx;padding:22rpx;background:#FDFDF8;min-height:150rpx;font-size:30rpx}.save-bar{position:fixed;left:0;right:0;bottom:0;padding:18rpx 40rpx calc(26rpx + env(safe-area-inset-bottom));background:#FCFCF8;border-top:1rpx solid #DCE4D6;z-index:10}.save-bar .small{font-size:26rpx;margin-bottom:14rpx;line-height:1.55}.media-grid{display:flex;flex-wrap:wrap;gap:20rpx;margin-top:24rpx}.media-item{width:calc(50% - 10rpx)}.media-item image,.media-item video{width:100%;height:240rpx;background:#E9EEE3;border-radius:10rpx}.media-item .quiet{font-size:26rpx;min-height:64rpx}
