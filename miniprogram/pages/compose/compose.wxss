@import '../../styles/common.wxss';

.tool.on { background: #007aff14; }
.recording { padding: 0 32rpx 8rpx; color: #007aff; font-size: 26rpx; }
.hint { padding: 0 32rpx 16rpx; color: #8e8e93; font-size: 24rpx; line-height: 1.4; }
.clock { color: #8e8e93; font-size: 30rpx; }
.time-box { display: flex; align-items: center; gap: 12rpx; }
.frozen-tag { font-size: 22rpx; color: #8e8e93; background: #f2f2f7; padding: 4rpx 12rpx; border-radius: 8rpx; }
.chip.locked { opacity: 0.9; }
.audio-tile {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #e5e5ea;
  color: #8e8e93;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.btn.ghost { opacity: 0.45; }
.interpret {
  margin: 0 32rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #3c3c43;
}
.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.privacy-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.privacy-title { font-size: 36rpx; font-weight: 600; }
.privacy-body { margin-top: 16rpx; font-size: 28rpx; color: #3c3c43; line-height: 1.55; }
.privacy-link { margin-top: 16rpx; color: #007aff; font-size: 28rpx; }
.privacy-ok {
  margin-top: 32rpx;
  background: #007aff;
  color: #fff;
  border-radius: 20rpx;
  font-size: 32rpx;
}
.privacy-ok::after { border: none; }
.privacy-no { text-align: center; color: #8e8e93; padding: 24rpx 0 0; font-size: 28rpx; }
.tools button.tool {
  padding: 0;
  margin: 0;
  border: none;
  background: #fff;
  color: #007aff;
  font-size: 28rpx;
  line-height: 72rpx;
  height: 72rpx;
}
.tools button.tool::after { border: none; }
.thumb-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.thumb-wrap image,
.thumb-wrap video,
.thumb-wrap .audio-tile {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: block;
}
.x {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 22rpx;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 28rpx;
  z-index: 2;
}
