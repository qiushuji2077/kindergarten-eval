<view class="page">
  <view class="title">观察记录</view>
  <view class="lead">把孩子正在做的事记下来。系统会对应到《3—6岁指南》。</view>
  <view class="section">园所名称</view>
  <input class="search" placeholder="写入报告封面，可不填" value="{{kindergartenName}}" bindinput="onKgName" />
  <view class="lead">不填则封面只写「幼儿园」。演示班可直接进入。</view>
  <view class="section">班级</view>
  <view class="group">
    <view class="cell" wx:for="{{classes}}" wx:key="id" bindtap="pickClass" data-id="{{item.id}}">
      <text class="name">{{item.name}}</text>
      <text class="mark" wx:if="{{classId === item.id}}">已选</text>
    </view>
  </view>
  <view class="section">教师</view>
  <view class="group">
    <view class="cell" wx:for="{{teachers}}" wx:key="id" bindtap="pickTeacher" data-id="{{item.id}}">
      <text class="name">{{item.name}}</text>
      <text class="mark" wx:if="{{teacherId === item.id}}">已选</text>
    </view>
  </view>
  <view class="agree {{agreed ? 'on' : ''}}" bindtap="toggleAgree">
    <view class="box">{{agreed ? '✓' : ''}}</view>
    <view class="agree-text">
      已阅读并同意
      <text class="link" catchtap="openPrivacy">《隐私保护指引》</text>
      和
      <text class="link" catchtap="openTerms">《用户服务协议》</text>
    </view>
  </view>
  <view class="btn {{agreed ? '' : 'ghost'}}" bindtap="enter">进入</view>
  <view class="link-row" bindtap="openAbout">使用说明</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
