.login-page{padding-top:62rpx}.brand-title{font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:84rpx;letter-spacing:10rpx;font-weight:500;margin:14rpx 0 22rpx;line-height:1.35}.brand-line{height:6rpx;width:70rpx;background:#C5945D;border-radius:3rpx;margin-bottom:34rpx}.hero-copy{font-size:41rpx;line-height:1.6;font-weight:500}.login-journey{display:flex;justify-content:space-between;margin:38rpx 0 36rpx;padding:24rpx 0;border-top:1rpx solid #D8E0D2;border-bottom:1rpx solid #D8E0D2}.login-journey>view{display:flex;flex-direction:column;font-size:26rpx}.number{font-family:Georgia,serif;font-size:30rpx;color:#91A28A;line-height:1.4;margin-bottom:8rpx}.agreement{font-size:26rpx;line-height:1.8;margin:22rpx 0;display:flex;align-items:center;flex-wrap:wrap;gap:6rpx}.agreement label{display:flex;align-items:center}.agreement .link{font-size:26rpx}
