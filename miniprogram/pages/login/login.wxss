@import '../../styles/common.wxss';
.agree {
  margin: 28rpx 32rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.box {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c7c7cc;
  border-radius: 8rpx;
  text-align: center;
  line-height: 32rpx;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.agree.on .box {
  background: #007aff;
  border-color: #007aff;
}
.agree-text { font-size: 24rpx; color: #8e8e93; line-height: 1.5; }
.link { color: #007aff; }
.link-row {
  text-align: center;
  color: #007aff;
  font-size: 28rpx;
  padding: 8rpx 32rpx 24rpx;
}
.btn.ghost { opacity: 0.45; }
