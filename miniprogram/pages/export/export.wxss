@import '../../styles/common.wxss';

.export-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.export-card {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 56rpx 40rpx 48rpx;
  box-sizing: border-box;
  text-align: center;
}
.write {
  position: relative;
  width: 280rpx;
  height: 160rpx;
  margin: 0 auto 36rpx;
  background: #f2f2f7;
  border-radius: 16rpx;
  overflow: hidden;
}
.write-line {
  height: 12rpx;
  margin: 28rpx 36rpx 0;
  border-radius: 8rpx;
  background: #d1d1d6;
  transform-origin: left center;
  transform: scaleX(0.18);
}
.write.run .l1 { animation: writeFill 1.1s ease-out forwards; }
.write.run .l2 { animation: writeFill 1.1s 0.35s ease-out forwards; }
.write.run .l3 { animation: writeFill 1.1s 0.7s ease-out forwards; }
.write.done .l1,
.write.done .l2,
.write.done .l3 {
  animation: none;
  transform: scaleX(1);
  background: #007aff;
}
.write-nib {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #007aff;
  left: 36rpx;
  top: 28rpx;
  box-shadow: 0 0 0 10rpx rgba(0, 122, 255, 0.18);
}
.write.run .write-nib { animation: nibWalk 2.1s ease-in-out infinite; }
.write-ok {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  background: #007aff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.export-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000;
}
.export-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.45;
}

@keyframes writeFill {
  from { transform: scaleX(0.18); }
  to { transform: scaleX(1); }
}
@keyframes nibWalk {
  0% { left: 36rpx; top: 28rpx; }
  32% { left: 220rpx; top: 28rpx; }
  38% { left: 36rpx; top: 68rpx; }
  70% { left: 200rpx; top: 68rpx; }
  76% { left: 36rpx; top: 108rpx; }
  100% { left: 168rpx; top: 108rpx; }
}
