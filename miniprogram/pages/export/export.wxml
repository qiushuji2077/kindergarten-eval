<view class="page">
  <view class="title">导出</view>
  <view class="lead">{{hint}}</view>
  <view class="section">园所名称（写入报告封面）</view>
  <input class="search" placeholder="可不填。不填则封面只写「幼儿园」" value="{{kindergartenName}}" bindinput="onKgName" />
  <view class="section">按幼儿导出</view>
  <view class="group">
    <view class="cell" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="exportChild">
      <view>
        <view class="name">{{item.name}}</view>
        <view class="sub">{{item.class_name}}</view>
      </view>
      <text class="mark">导出</text>
    </view>
  </view>
  <view class="btn" style="background:#e5e5ea;color:#000;font-weight:500" bindtap="logout">切换教师</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="export-mask" wx:if="{{busy}}">
    <view class="export-card">
      <view class="write {{phase === 'aiDone' ? 'done' : ''}} {{phase === 'summarize' || phase === 'aiDone' ? 'run' : ''}}">
        <view class="write-line l1"></view>
        <view class="write-line l2"></view>
        <view class="write-line l3"></view>
        <view class="write-nib" wx:if="{{phase !== 'aiDone'}}"></view>
        <view class="write-ok" wx:else>✓</view>
      </view>
      <view class="export-title">{{busyTitle}}</view>
      <view class="export-sub">{{busySub}}</view>
    </view>
  </view>
</view>
